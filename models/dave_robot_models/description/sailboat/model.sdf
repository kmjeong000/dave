<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sailboat">

    <enable_wind>true</enable_wind>

	  <link name="base_link">
		  <inertial>
			  <pose>-0.001323 0.000769 0.097199 0 0 0</pose>
  			<mass>49.895</mass>
	  		<inertia>
          <ixx>30.09</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.63</iyy>
          <iyz>0</iyz>
          <izz>32.90</izz>
			  </inertia>
  		</inertial>
  		<visual name="hull_visual">
        <cast_shadows>true</cast_shadows>
	  		<pose>0 0 0 0 0 0</pose>
		  	<geometry>
			  	<mesh>
				  	<scale>1 1 1</scale>
					  <uri>model://meshes/sailboat/hull.stl</uri>
  				</mesh>
	  		</geometry>
        <material>
          <ambient>0.1 0.25 0.3 1</ambient>
          <diffuse>0.5 0.55 0.6 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
		  </visual>
  		<collision name="hull_collision">
	  		<pose>0 0 0 0 0 0</pose>
		  	<geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/hull_collision.stl</uri>
          </mesh>
	  		</geometry>
		  </collision>
  	</link>

    <link name="sail_link">
      <self_collide>false</self_collide>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
			  <mass>5.0</mass>
  			<inertia>
          <ixx>4.36</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.13</iyy>
          <iyz>0</iyz>
          <izz>0.905</izz>
  			</inertia>
      </inertial>
      <visual name="visual">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/sail.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.17 0.21 0.25 1</ambient>
          <diffuse>0.42 0.47 0.51 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="sail_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/sail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="sail_joint" type="revolute">
      <pose>0.000564 0.926389 0.243424 0 0 0</pose>
      <parent>base_link</parent>
      <child>sail_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.5708</lower>  <!-- -90° -->
          <upper>1.5708</upper>   <!-- +90° -->
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="rudder_link">
      <self_collide>false</self_collide>
      <inertial>
        <pose>0.002863 -1.635017 -0.003987 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.132</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.111</iyy>
          <iyz>0</iyz>
          <izz>0.022</izz>
		  	</inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/rudder.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.17 0.21 0.25 1</ambient>
          <diffuse>0.42 0.47 0.51 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="rudder_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/rudder_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="rudder_joint" type="revolute">
      <pose>0.001838 -1.542248 0.183647 0 0 0</pose>
      <parent>base_link</parent>
      <child>rudder_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.611</lower>   <!-- -35° -->
          <upper>0.611</upper>    <!-- +35° -->
          <effort>50</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.58</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="daggerboard_link">
      <inertial>
        <pose>0.000710 0.141003 -0.080877 0 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.408</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.362</iyy>
          <iyz>0.0</iyz>
          <izz>0.049</izz>
		  	</inertia>
      </inertial>
      <visual name="visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/daggerboard.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.17 0.21 0.25 1</ambient>
          <diffuse>0.42 0.47 0.51 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="daggerboard_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/daggerboard_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>  
    <joint name="daggerboard_joint" type="fixed">
      <pose>0.000710 0.141003 -0.080877 0 0 0</pose>
      <parent>base_link</parent>
      <child>daggerboard_link</child>
    </joint>

<!-- ======== sensor ======== -->

    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="anemometer_link">
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="anemometer" type="custom" gz:type="anemometer">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <gz:anemometer>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.5</stddev>
          </noise>
        </gz:anemometer>
      </sensor>
    </link>
    
    <joint name="anemometer_joint" type="fixed">
      <parent>base_link</parent>
      <child>anemometer_link</child>
    </joint>

    <link name="magnetometer_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.4</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
    </link>

    <joint name="magnetometer_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>magnetometer_link</child>
    </joint>

    <link name="camera_link">
      <pose relative_to="base_link">0 1.0 0.23 0 0 1.5078</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://meshes/sailboat/3dCamera.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.4835</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <!--
          <save enabled="true">
            <path>/Users/kimminjung/Desktop/camera_output</path>
          </save>
          -->
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="camera_link_optical">
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_link_optical</child>
      <pose relative_to="camera_link">0 0 0 -1.5708 0 -1.5708</pose>
    </joint>

    <link name="gps_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>5.0</update_rate>
      </sensor>
    </link>
    <joint name="gps_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <plugin 
      filename="wave-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <enable>sailboat::base_link</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>1</pressure_drag_on>

        <cDampL1>1.0e-5</cDampL1>
        <cDampL2>1.0e-5</cDampL2>
        <cDampR1>1.0e-5</cDampR1>
        <cDampR2>1.0e-5</cDampR2>

        <cPDrag1>240.0</cPDrag1>
        <cPDrag2>240.0</cPDrag2>
        <fPDrag>0.45</fPDrag>

        <cSDrag1>320.0</cSDrag1>
        <cSDrag2>320.0</cSDrag2>
        <fSDrag>0.45</fSDrag>

        <vRDrag>1.9</vRDrag>
      </hydrodynamics>
    </plugin>
    <plugin 
      filename="wave-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <enable>sailboat::rudder_link</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>0</pressure_drag_on>

        <cDampL1>2.0e-6</cDampL1>
        <cDampL2>2.0e-6</cDampL2>
        <cDampR1>2.0e-6</cDampR1>
        <cDampR2>2.0e-6</cDampR2>

        <cSDrag1>200.0</cSDrag1>
        <cSDrag2>200.0</cSDrag2>
        <fSDrag>0.5</fSDrag>

        <vRDrag>0.9</vRDrag>
      </hydrodynamics>
    </plugin>
    <plugin 
      filename="wave-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <enable>sailboat::daggerboard_link</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>0</pressure_drag_on>

        <cDampL1>3.0e-6</cDampL1>
        <cDampL2>3.0e-6</cDampL2>
        <cDampR1>3.0e-6</cDampR1>
        <cDampR2>3.0e-6</cDampR2>

        <cSDrag1>280.0</cSDrag1>
        <cSDrag2>280.0</cSDrag2>
        <fSDrag>0.5</fSDrag>
        
        <vRDrag>1.1</vRDrag>
      </hydrodynamics>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin 
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin 
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 0 0 1.5708</modelXYZToAirplaneXForwardZDown>

      <!-- Transform from the Gazebo world frame (ENU)
           to the ArduPilot world frame (North-East-Down) -->
      <gazeboXYZToNED>0 0 0 3.142 0 0</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>
      <anemometer>anemometer_link::anemometer</anemometer>

      <!-- Servo 1: ArduRover ground steering -> rudder joint target angle. -->
      <control channel="0">
        <jointName>rudder_joint</jointName>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/sailboat/joint/rudder_joint/cmd_pos</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>1.222</multiplier>
      </control>

      <!-- Servo 2: ArduRover sail mast rotation -> sail joint target angle. -->
      <control channel="1">
        <jointName>sail_joint</jointName>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/sailboat/joint/sail_joint/cmd_pos</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>3.1416</multiplier>
      </control>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <topic>/model/sailboat/joint/rudder_joint/cmd_pos</topic>
      <p_gain>25</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>50</cmd_max>
      <cmd_min>-50</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>sail_joint</joint_name>
      <topic>/model/sailboat/joint/sail_joint/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

  </model>
</sdf>

