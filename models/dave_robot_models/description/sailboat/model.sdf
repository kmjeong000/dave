          <ixx>5.55</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>40.91</iyy>
          <iyz>0</iyz>
          <izz>45.06</izz>
				</inertia>
			</inertial>

			<visual name="hull_visual">
				<pose>0 0 0 0 0 0</pose>
