<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sailboat">
    <enable_wind>true</enable_wind>

	  <link name="base_link">
		  <inertial>
			  <pose>-0.004305 0.229980 -0.009473 0 0 0</pose>
  			<mass>49.895</mass>
	  		<inertia>
          <ixx>26.811</ixx>
          <ixy>-0.009</ixy>
          <ixz>0.001</ixz>
          <iyy>3.239</iyy>
          <iyz>0.304</iyz>
          <izz>29.308</izz>
			  </inertia>
  		</inertial>
  		<visual name="hull_visual">
	  		<pose>0 0 0 0 0 0</pose>
		  	<geometry>
			  	<mesh>
				  	<scale>1 1 1</scale>
					  <uri>model://meshes/sailboat/hull.stl</uri>
  				</mesh>
	  		</geometry>
		  </visual>
  		<collision name="hull_collision">
	  		<pose>0 0 0 0 0 0</pose>
		  	<geometry>
			  	<box>
				  	<size>1.078 3.103 0.378</size>
  				</box>
	  		</geometry>
		  </collision>
  	</link>

    <link name="sail_link">
      <inertial>
        <pose>-0.059323 0.622302 1.818636 0 0 0</pose>
			  <mass>3.0</mass>
  			<inertia>
          <ixx>2.517</ixx>
          <ixy>-0.006</ixy>
          <ixz>-0.012</ixz>
          <iyy>2.016</iyy>
          <iyz>-0.394</iyz>
          <izz>0.508</izz>
  			</inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/sail.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="sail_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.171 2.044 4.149</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="sail_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>sail_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.5708</lower>  <!-- -90° -->
          <upper>1.5708</upper>   <!-- +90° -->
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="rudder_link">
      <inertial>
        <pose>-0.004030 -1.305001 -0.085000 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.101</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.085</iyy>
          <iyz>-0.014</iyz>
          <izz>0.017</izz>
		  	</inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/rudder.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="rudder_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.064 0.551 0.695</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="rudder_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rudder_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.611</lower>   <!-- -35° -->
          <upper>0.611</upper>    <!-- +35° -->
          <effort>50</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.08</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="daggerboard_link">
      <inertial>
        <pose>-0.006 0.358 -0.179 0 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.365</ixx>
          <ixy>0.0</ixy>
          <ixz>-0.002</ixz>
          <iyy>0.320</iyy>
          <iyz>-0.076</iyz>
          <izz>0.045</izz>
		  	</inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/sailboat/daggerboard.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="daggerboard_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.049 0.402 0.743</size>
          </box>
        </geometry>
      </collision>
    </link>  
    <joint name="daggerboard_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>daggerboard_link</child>
    </joint>

<!-- ======== sensor ======== -->

    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/model/sailboat/imu</topic>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="magnetometer_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/model/sailboat/magnetometer</topic>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.4</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
    </link>

    <joint name="magnetometer_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>magnetometer_link</child>
    </joint>

    <link name="camera_link">
      <pose relative_to="base_link">0 1.2 0.378 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://meshes/sailboat/3dCamera.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.4835</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <!--
          <save enabled="true">
            <path>/Users/kimminjung/Desktop/camera_output</path>
          </save>
          -->
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="camera_link_optical">
    </link>

    <joint name="camera_optical_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_link_optical</child>
      <pose relative_to="camera_link">0 0 0 -1.5708 0 -1.5708</pose>
    </joint>

    <link name="gps_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>5.0</update_rate>
        <topic>/model/sailboat/gps/fix</topic>
      </sensor>
    </link>
    <joint name="gps_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <plugin 
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <disable_coriolis>false</disable_coriolis>
      <disable_added_mass>true</disable_added_mass>

      <water_density>1028</water_density>
      <link_name>base_link</link_name>

      <!-- Linear Drag Coefficients -->
      <xU>-1.46</xU>
      <yV>-6.63</yV>
      <zW>-10.31</zW>
      <kP>-3.00</kP>
      <mQ>-3.53</mQ>
      <nR>-15.95</nR>

      <!-- Quadratic Drag Coefficients -->
      <xUabsU>-146.44</xUabsU>
      <yVabsV>-662.53</yVabsV>
      <zWabsW>-1031.45</zWabsW>
      <kPabsP>-299.55</kPabsP>
      <mQabsQ>-352.52</mQabsQ>
      <nRabsR>-1594.90</nRabsR>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin 
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin 
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

  </model>
</sdf>

